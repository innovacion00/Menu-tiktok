---
interface Props {
  image?: string;
  video?: string;
  poster?: string;
  title: string;
  description: string;
  price?: string;
  alt?: string;
  tags?: string[];
}

const { image, video, poster, title, description, price, alt = title, tags = [] } = Astro.props;
---

<section class="slide" data-slide>
  {video ? (
    <video
      class="slide__media slide__video"
      data-slide-video
      src={video}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={poster}
    />
  ) : (
    <img
      class="slide__image"
      src={image}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="slide__overlay" aria-hidden="true"></div>
  <div class="slide__content">
    <h2 class="slide__title">{title}</h2>
    <p class="slide__description">{description}</p>
    {tags.length > 0 && (
      <div class="slide__badges" aria-label="Etiquetas del plato">
        {tags.map((tag) => (
          <span class="slide__badge">{tag}</span>
        ))}
      </div>
    )}
    {price && <p class="slide__price">{price}</p>}
  </div>
</section>
