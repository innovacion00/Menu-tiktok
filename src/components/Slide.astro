---
interface Props {
  image: string;
  title: string;
  description: string;
  price?: string;
  alt?: string;
}

const { image, title, description, price, alt = title } = Astro.props;
---

<section class="slide" data-slide>
  <img
    class="slide__image"
    src={image}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
  <div class="slide__overlay" aria-hidden="true"></div>
  <div class="slide__content">
    <h2 class="slide__title">{title}</h2>
    <p class="slide__description">{description}</p>
    {price && <p class="slide__price">{price}</p>}
  </div>
</section>
