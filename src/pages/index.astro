---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Slide.astro';
import { slides } from '../data/slides.js';

// Tres vueltas del menú para simular un feed largo e "infinito"
const loopSlides = [...slides, ...slides, ...slides];
---

<Layout>
  <div class="feed-wrapper">
    <main class="feed-container" id="feed" aria-label="Menú en formato vertical">
      {loopSlides.map((slide, index) => (
        <Slide
          image={slide.image}
          video={(slide as any).video}
          poster={(slide as any).poster}
          originalId={slide.id}
          renderIndex={index}
          title={slide.title}
          description={slide.description ?? ''}
          price={slide.price}
          alt={slide.title}
          tags={slide.tags}
        />
      ))}
    </main>

    <div class="floating-actions" aria-label="Acciones">
      <button type="button" class="action-btn action-btn--grid" id="btn-grid" aria-label="Ver menú en cuadrícula">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1"></rect>
        </svg>
      </button>
      <button type="button" class="action-btn action-btn--like" id="btn-like" aria-label="Me gusta" aria-pressed="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </button>
      <!-- <button type="button" class="action-btn action-btn--comment" id="btn-comment" aria-label="Comentarios">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </button> -->
      <button type="button" class="action-btn action-btn--share" id="btn-share" aria-label="Compartir">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="M8.59 13.51L15.42 17.49"></path>
          <path d="M15.41 6.51L8.59 10.49"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="grid-modal" id="grid-modal" aria-hidden="true" role="dialog" aria-label="Vista general del menú">
    <div class="grid-modal__backdrop" data-grid-close></div>
    <div class="grid-modal__panel" role="document">
      <div class="grid-modal__header">
        <h2 class="grid-modal__title">Menú</h2>
        <button type="button" class="grid-modal__close" data-grid-close aria-label="Cerrar">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"></path>
            <path d="M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="grid-modal__content">
        <div class="grid" id="grid">
          {slides.map((s) => (
            <button
              type="button"
              class="grid-card"
              data-grid-card
              data-target-id={s.id}
              data-has-video={Boolean((s as any).video)}
              data-video-src={(s as any).video}
              data-poster={(s as any).poster}
              aria-label={`Ir a: ${s.title}`}
            >
              <div class="grid-card__media">
                {(s as any).video ? (
                  <video
                    class="grid-card__thumb"
                    data-grid-video
                    muted
                    playsinline
                    preload="none"
                    data-video-src={(s as any).video}
                    poster={(s as any).poster}
                  />
                ) : (
                  <img class="grid-card__thumb" src={s.image} alt={s.title} loading="lazy" decoding="async" />
                )}
                {(s as any).video && <span class="grid-card__play" aria-hidden="true"></span>}
              </div>

              <div class="grid-card__meta">
                <div class="grid-card__title">{s.title}</div>
                {s.price && <div class="grid-card__price">{s.price}</div>}
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // @ts-nocheck
  (function () {
    const feed = document.getElementById('feed');
    const btnGrid = document.getElementById('btn-grid');
    const gridModal = document.getElementById('grid-modal');
    const btnLike = document.getElementById('btn-like');
    const btnComment = document.getElementById('btn-comment');
    const btnShare = document.getElementById('btn-share');
    const slides = document.querySelectorAll('[data-slide]');
    let currentTitle = '';
    let currentPrice = '';
    let activeVideo = /** @type {any} */ (null);
    let currentVisibleVideo = /** @type {any} */ (null);
    const isiOS =
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    let userInteracted = false;

    const getSoundOverlay = (videoEl) => {
      const slideEl = videoEl?.closest?.('[data-slide]');
      if (!slideEl) return null;
      return slideEl.querySelector('[data-sound-overlay]');
    };

    const showSoundOverlay = (videoEl) => {
      const overlay = getSoundOverlay(videoEl);
      if (!overlay) return;
      overlay.classList.remove('slide__sound-overlay--hidden');

      const isMuted = videoEl?.muted !== false;
      overlay.classList.toggle('slide__sound-overlay--unmuted', !isMuted);
      overlay.setAttribute(
        'aria-label',
        isMuted
          ? 'Video en silencio. Toca para activar el sonido'
          : 'Sonido activado. Toca para reproducir de nuevo'
      );
    };

    const hideSoundOverlay = (videoEl) => {
      const overlay = getSoundOverlay(videoEl);
      if (!overlay) return;
      overlay.classList.add('slide__sound-overlay--hidden');
      overlay.classList.remove('slide__sound-overlay--unmuted');
    };

    const openGrid = () => {
      if (!gridModal) return;
      gridModal.classList.add('grid-modal--open');
      gridModal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('no-scroll');

      // Previsualización estática para videos: cargamos metadata y mostramos 1er frame.
      const gridVideos = gridModal.querySelectorAll('video[data-grid-video]');
      gridVideos.forEach((videoEl) => {
        const src = videoEl?.dataset?.videoSrc;
        if (!src) return;

        if (!videoEl.getAttribute('src')) {
          videoEl.src = src;
          try {
            videoEl.load();
          } catch {
            // no-op
          }
        }

        const ensureFirstFrame = () => {
          try {
            if (Number.isFinite(videoEl.duration) && videoEl.duration > 0) {
              const t = Math.min(0.05, Math.max(0, (videoEl.duration ?? 0) * 0.001));
              if (!Number.isNaN(t)) videoEl.currentTime = t;
            } else {
              videoEl.currentTime = 0.01;
            }
          } catch {
            // no-op
          }

          try {
            videoEl.pause();
          } catch {
            // no-op
          }
        };

        if (videoEl.readyState >= 2) {
          ensureFirstFrame();
        } else {
          const onLoaded = () => {
            ensureFirstFrame();
            videoEl.removeEventListener('loadeddata', onLoaded);
          };
          videoEl.addEventListener('loadeddata', onLoaded);
        }
      });
    };

    const closeGrid = () => {
      if (!gridModal) return;
      gridModal.classList.remove('grid-modal--open');
      gridModal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('no-scroll');
    };

    if (btnGrid) {
      btnGrid.addEventListener('click', openGrid);
    }

    if (gridModal) {
      gridModal.addEventListener('click', (e) => {
        const target = e.target;
        if (target?.closest?.('[data-grid-close]')) {
          closeGrid();
        }
      });

      const scrollToSlide = (originalId) => {
        if (!feed) return;
        const idStr = String(originalId);
        const matches = Array.from(
          document.querySelectorAll(`[data-slide][data-slide-original-id="${idStr}"]`)
        );
        if (!matches.length) return;

        // Usamos la copia del medio (2da vuelta) para no romper el “infinito”.
        const uniqueCount = slides?.length ? slides.length / 3 : 0;
        const targetIndex = uniqueCount || 0;

        let best = matches[0];
        let bestScore = Infinity;
        for (const el of matches) {
          const idxRaw = el?.dataset?.slideRenderIndex;
          const idx = idxRaw ? Number.parseInt(idxRaw, 10) : 0;
          const score = Math.abs(idx - targetIndex);
          if (score < bestScore) {
            best = el;
            bestScore = score;
          }
        }

        // Cerramos el modal y navegamos.
        closeGrid();
        requestAnimationFrame(() => {
          try {
            best.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } catch {
            // fallback
            try {
              best.scrollIntoView();
            } catch {
              // no-op
            }
          }
        });
      };

      gridModal.addEventListener('click', (e) => {
        const card = e.target?.closest?.('[data-grid-card]');
        if (!card) return;
        const targetId = card.dataset?.targetId;
        if (!targetId) return;
        scrollToSlide(targetId);
      });
    }

    if (btnLike) {
      btnLike.addEventListener('click', function () {
        const isLiked = this.classList.toggle('liked');
        this.setAttribute('aria-pressed', isLiked ? 'true' : 'false');
      });
    }

    if (btnComment) {
      btnComment.addEventListener('click', function () {
        this.classList.toggle('active');
      });
    }

    if (btnShare) {
      btnShare.addEventListener('click', async function () {
        // Micro-animación del botón
        this.classList.add('shared');
        window.setTimeout(() => this.classList.remove('shared'), 220);

        const url = window.location.href;
        const textBase =
          currentTitle
            ? `Mira este plato: ${currentTitle}${
                currentPrice ? ' - ' + currentPrice : ''
              }`
            : 'Mira este menú digital';

        // Web Share API (método A)
        if (navigator.share) {
          try {
            await navigator.share({
              title: currentTitle || 'Menú digital',
              text: textBase,
              url,
            });
            return;
          } catch (err) {
            // Si el usuario cancela o falla, seguimos al fallback
          }
        }

        // Fallback: abrir WhatsApp con texto prellenado
        const msg = encodeURIComponent(`${textBase}\n${url}`);
        window.open(`https://wa.me/?text=${msg}`, '_blank', 'noopener,noreferrer');
      });
    }

    if (feed && slides.length) {
      const slideArray = Array.from(slides);

      const videoNodes = feed.querySelectorAll('video[data-slide-video]');

      // iOS Safari suele requerir un gesto del usuario para habilitar reproducción.
      // Usamos esta bandera para evitar llamadas a `play()` antes del primer toque/click.
      feed.addEventListener(
        'touchstart',
        () => {
          userInteracted = true;
        },
        { passive: true, once: true }
      );
      feed.addEventListener(
        'click',
        () => {
          userInteracted = true;
        },
        { once: true }
      );

      /**
       * Carga la URL del video solo cuando el slide entra en viewport.
       * (El markup ya trae `data-video-src` pero sin `src` inicial.)
       */
      const loadVideoIfNeeded = (videoEl) => {
        if (!videoEl) return;

        const videoSrc = videoEl.dataset?.videoSrc;
        if (!videoSrc) return;

        // Si todavía no tiene `src`, lo asignamos a partir de `data-video-src`.
        if (!videoEl.getAttribute('src')) {
          videoEl.src = videoSrc;
          try {
            videoEl.load();
          } catch {
            // no-op
          }
        }
      };

      /**
       * Reproduce un video (por defecto en muted). Solo dejamos uno “activo” a la vez.
       */
      const playVideo = async (
        videoEl,
        { unmute = false } = /** @type {any} */ ({})
      ) => {
        if (!videoEl) return;

        loadVideoIfNeeded(videoEl);

        // Exclusividad: pausamos lo activo si es otro slide.
        if (activeVideo && activeVideo !== videoEl) {
          const previous = activeVideo;
          try {
            previous.pause();
          } catch {
            // no-op
          }
          previous.muted = true;
          hideSoundOverlay(previous);
          activeVideo = null;
        }

        videoEl.muted = !unmute;
        showSoundOverlay(videoEl);

        try {
          if (videoEl.paused) {
            await videoEl.play();
          }
          activeVideo = videoEl;
          showSoundOverlay(videoEl);
          return;
        } catch {
          // Fallback: si no deja con audio, intentamos con muted.
          try {
            videoEl.muted = true;
            if (videoEl.paused) {
              await videoEl.play();
            }
            activeVideo = videoEl;
            showSoundOverlay(videoEl);
          } catch {
            // no-op
          }
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visibleEntries = entries
            .filter((e) => e.isIntersecting)
            .sort(
              (a, b) =>
                (b.intersectionRatio ?? 0) - (a.intersectionRatio ?? 0)
            );

          if (!visibleEntries.length) return;
          const entry = visibleEntries[0];

          entry.target.classList.add('slide--visible');

          const currentVideo = /** @type {any} */ (
            entry.target.querySelector('video[data-slide-video]')
          );
          currentVisibleVideo = currentVideo || null;

          // Si entramos a un slide que NO tiene video, cortamos cualquier audio en curso.
          if (!currentVideo) {
            if (activeVideo) {
              hideSoundOverlay(activeVideo);
              try {
                activeVideo.pause();
              } catch {
                // no-op
              }
              activeVideo.muted = true;
              activeVideo = null;
            }
          } else {
            // Cargamos el src al entrar en viewport, pero en iOS Safari evitamos `play()`
            // hasta que el usuario haya interactuado al menos una vez.
            loadVideoIfNeeded(currentVideo);

            // Si cambiamos de slide, aseguramos que solo el visible tenga overlay.
            if (activeVideo && activeVideo !== currentVideo) {
              const previous = activeVideo;
              try {
                previous.pause();
              } catch {
                // no-op
              }
              previous.muted = true;
              hideSoundOverlay(previous);
              activeVideo = null;
            }

            // El overlay siempre se muestra mientras el slide con video es visible
            // (aunque iOS Safari no permita reproducir hasta el primer gesto).
            showSoundOverlay(currentVideo);

            if (!isiOS || userInteracted) {
              void playVideo(currentVideo, { unmute: false });
            }
          }

          // Actualizamos el plato actual para compartir
          const titleEl = entry.target.querySelector('.slide__title');
          const priceEl = entry.target.querySelector('.slide__price');
          currentTitle = titleEl?.textContent?.trim() || '';
          currentPrice = priceEl?.textContent?.trim() || '';
        },
        { root: feed, rootMargin: '0px', threshold: 0.5 }
      );
      slideArray.forEach((el) => observer.observe(el));

      // Los videos se cargan en muted para autoplay.
      // - En swipe/scroll, aseguramos reproducción del slide visible.
      // - Si había un video con sonido, el nuevo se desmuteará automáticamente (si el navegador lo permite).
      videoNodes.forEach((videoNode) => {
        const video = /** @type {any} */ (videoNode);
        const slideEl = video.closest('[data-slide]');
        if (!slideEl) return;

        let startX = 0;
        let startY = 0;
        let startTime = 0;
        let hasTouchStart = false;

        slideEl.addEventListener(
          'touchstart',
          (e) => {
            // @ts-ignore - changedTouches en type Event
            const t = /** @type {any} */ (e).changedTouches?.[0];
            if (!t) return;
            startX = t.clientX;
            startY = t.clientY;
            startTime = Date.now();
            hasTouchStart = true;
          },
          { passive: true }
        );

        slideEl.addEventListener(
          'touchend',
          (e) => {
            // @ts-ignore - changedTouches en type Event
            const t = /** @type {any} */ (e).changedTouches?.[0];
            if (!t || !hasTouchStart) return;

            const dx = Math.abs(t.clientX - startX);
            const dy = Math.abs(t.clientY - startY);
            const dt = Date.now() - startTime;

            // Consideramos "tap" si el desplazamiento es pequeño.
            if (dx < 12 && dy < 12 && dt < 350) {
              userInteracted = true;
              void playVideo(video, { unmute: true });
            }

            hasTouchStart = false;
          },
          { passive: true }
        );

        // Desktop fallback: click para desmutear.
        slideEl.addEventListener('click', () => {
          userInteracted = true;
          void playVideo(video, { unmute: true });
        });
      });

      // Simular scroll infinito: usamos varias copias del mismo set de slides.
      // Cuando el usuario se acerca al final de la última copia,
      // reajustamos scrollTop restando una "vuelta", de forma que
      // visualmente se mantiene en el mismo contenido.
      const uniqueCount = slides.length / 3;
      let isAdjusting = false;

      feed.addEventListener('scroll', () => {
        if (!uniqueCount || isAdjusting) return;

        const current = feed.scrollTop;
        const cycleHeight = feed.clientHeight * uniqueCount;

        // Si por cualquier razón aún no tenemos altura, salimos.
        if (!cycleHeight) return;

        // Cuando el usuario ya ha pasado de 1.5 vueltas,
        // recolocamos hacia atrás una vuelta completa.
        if (current > cycleHeight * 2) {
          isAdjusting = true;
          feed.scrollTop = current - cycleHeight;
          isAdjusting = false;
        }
      });
    }
  })();
</script>

<style>
  .feed-wrapper {
    position: relative;
    max-width: 430px;
    margin: 0 auto;
    /* quita estas dos líneas problemáticas:
       min-height: 100vh;
       height: 100vh;
    */
  }
</style>